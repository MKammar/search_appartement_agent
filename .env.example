# Gmail IMAP and SMTP. Use a Google App Password, not your Google account password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.address@gmail.com
IMAP_PASSWORD=replace-with-google-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=your.address@gmail.com
