# IMAP: use an app-specific password or provider token where available.
IMAP_HOST=replace-with-imap-host
IMAP_PORT=993
IMAP_USER=replace-with-mailbox-login
IMAP_PASSWORD=replace-with-app-password

# SMTP: choose STARTTLS (587) or implicit SSL (465), not both.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_USER=replace-with-smtp-login
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=replace-with-sender@example.com
